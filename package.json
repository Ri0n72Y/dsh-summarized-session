{
  "name": "dsh-summarized-session",
  "version": "0.1.0-alpha.0",
  "private": true,
  "description": "Summarized working memory for DSH 0.1.7-alpha.1.",
  "type": "module",
  "packageManager": "pnpm@11.7.0",
  "engines": { "node": "^22.19.0 || >=24.0.0" },
  "repository": { "type": "git", "url": "git+https://github.com/Ri0n72Y/dsh-summarized-session.git" },
  "main": "./lib/index.js",
  "types": "./lib/index.d.ts",
  "exports": {
    ".": { "types": "./lib/index.d.ts", "import": "./lib/index.js" },
    "./client": "./lib/client.js",
    "./preset": { "types": "./lib/preset.d.ts", "import": "./lib/preset.js" },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": ["lib", "cordis.patch.yml", "README.md", "LICENSE"],
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-ui-chat",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-ui-session",
        "@deepseek-ai/dsh-client-ui-sidebar-right"
      ]
    }
  },
  "scripts": {
    "build": "tsdown --config tsdown.config.ts",
    "prepare": "npm run build",
    "test": "node --test tests/*.test.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.host.json && tsc --noEmit -p tsconfig.client.json && tsc --noEmit -p tsconfig.build.json"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.3",
    "@deepseek-ai/dsh-agent": "0.1.7-alpha.1",
    "@deepseek-ai/dsh-client-connection": "0.1.7-alpha.1",
    "@deepseek-ai/dsh-client-ui-chat": "0.1.7-alpha.1",
    "@deepseek-ai/dsh-client-ui-conversation": "0.1.7-alpha.1",
    "@deepseek-ai/dsh-client-ui-renderer": "0.1.7-alpha.1",
    "@deepseek-ai/dsh-client-ui-session": "0.1.7-alpha.1",
    "@deepseek-ai/dsh-client-ui-sidebar-right": "0.1.7-alpha.1",
    "@deepseek-ai/dsh-client-ui-slots": "0.1.7-alpha.1",
    "@deepseek-ai/dsh-llm": "0.1.7-alpha.1",
    "@deepseek-ai/dsh-session": "0.1.7-alpha.1",
    "@deepseek-ai/dsh-system-prompt": "0.1.7-alpha.1",
    "@deepseek-ai/schemastery": "^3.18.3",
    "react": "^18.2.0"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.3",
    "@deepseek-ai/dsh-agent": "0.1.7-alpha.1",
    "@deepseek-ai/dsh-client-connection": "0.1.7-alpha.1",
    "@deepseek-ai/dsh-client-ui-chat": "0.1.7-alpha.1",
    "@deepseek-ai/dsh-client-ui-conversation": "0.1.7-alpha.1",
    "@deepseek-ai/dsh-client-ui-renderer": "0.1.7-alpha.1",
    "@deepseek-ai/dsh-client-ui-session": "0.1.7-alpha.1",
    "@deepseek-ai/dsh-client-ui-sidebar-right": "0.1.7-alpha.1",
    "@deepseek-ai/dsh-client-ui-slots": "0.1.7-alpha.1",
    "@deepseek-ai/dsh-llm": "0.1.7-alpha.1",
    "@deepseek-ai/dsh-session": "0.1.7-alpha.1",
    "@deepseek-ai/dsh-system-prompt": "0.1.7-alpha.1",
    "@deepseek-ai/schemastery": "3.18.3",
    "@types/node": "^22.20.0",
    "@types/react": "~18.3.1",
    "react": "^18.2.0",
    "tsdown": "^0.22.2",
    "typescript": "^6.0.3"
  }
}
